# Copy to .env before the first `docker compose up -d`.

# Both generated with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# Port the dashboard is served on.
PORT=8080

# Must match how you reach the app, or SvelteKit will reject form posts.
ORIGIN=http://localhost:8080

# Session cookies are Secure-only by default. Set to 1 if you serve plain HTTP
# (e.g. straight to a LAN IP with no TLS terminator in front).
INSECURE_COOKIES=

# Timestamps are rendered in this zone, on both the server and the runner.
TZ=Europe/Prague
